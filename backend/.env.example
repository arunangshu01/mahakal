# Local development settings. Copy to backend/.env (never commit it).
# In production these come from Cloud Run env vars and Secret Manager (see docs/deploy-gcp.md).

# Where GROQ_API_KEY, GEMINI_API_KEY, GOOGLE_CLIENT_ID and SESSION_SECRET come from:
#   env            - the values below (default)
#   secret-manager - read from Google Secret Manager at startup; needs GOOGLE_CLOUD_PROJECT and
#                    `gcloud auth application-default login`. Values set below still take priority.
SECRETS_SOURCE=env

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Model on Groq free tier
GROQ_MODEL=openai/gpt-oss-120b

# Fallback when Groq fails or is rate-limited. Free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Voice name for edge-tts (run `edge-tts --list-voices` for options)
TTS_VOICE=en-IN-PrabhatNeural

# Google sign-in: the OAuth web client ID (not secret). The client secret is not needed.
GOOGLE_CLIENT_ID=

# Signs the login cookie. Generate with: openssl rand -hex 32
# Leave empty locally to use a temporary one (you'll be signed out when the server restarts).
SESSION_SECRET=

# Free messages before guests are asked to sign in
GUEST_MESSAGE_LIMIT=5

# "memory" (default, nothing to set up) or "firestore" (needs `gcloud auth application-default login`)
STORAGE_BACKEND=memory
GOOGLE_CLOUD_PROJECT=

# Only over HTTPS. Keep false for http://localhost.
COOKIE_SECURE=false

# Comma-separated origins allowed to call the API (only needed if the UI is hosted elsewhere)
CORS_ORIGINS=http://localhost:5173
