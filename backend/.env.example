# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Model on Groq free tier
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback when Groq fails or is rate-limited. Free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Voice name for edge-tts (run `edge-tts --list-voices` for options)
TTS_VOICE=en-IN-PrabhatNeural

# Comma-separated origins allowed to call the API (only needed if the UI is hosted elsewhere)
CORS_ORIGINS=http://localhost:5173
